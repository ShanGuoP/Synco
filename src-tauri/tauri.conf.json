{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synco Photo",
  "identifier": "app.synco.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/prepare-build.ps1",
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "headers": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Synco Photo",
    "longDescription": "Synco Photo：本机 ComfyUI / 云端局部重绘工作台",
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  },
  "plugins": {}
}
